
digraph UrbanStyle {
    graph [
        rankdir=LR,
        bgcolor="white",
        pad="0.35",
        nodesep="0.65",
        ranksep="1.0",
        splines=ortho,
        fontname="Arial",
        label="URBAN STYLE\nModelo Entidad–Relación — Base de datos MySQL 2.0",
        labelloc="t",
        fontsize=22
    ];

    node [
        shape=plain,
        fontname="Arial"
    ];

    edge [
        color="#555555",
        penwidth=1.2,
        arrowsize=0.8,
        fontname="Arial",
        fontsize=10
    ];

    categoria [label=<
      <TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" CELLPADDING="6">
        <TR><TD COLSPAN="2" BGCOLOR="#D9EAF7"><B>CATEGORIA</B></TD></TR>
        <TR><TD><B>PK</B></TD><TD ALIGN="LEFT"><B>id_categoria</B> INT</TD></TR>
        <TR><TD></TD><TD ALIGN="LEFT">nombre VARCHAR(100) UNIQUE</TD></TR>
        <TR><TD></TD><TD ALIGN="LEFT">descripcion VARCHAR(255)</TD></TR>
        <TR><TD></TD><TD ALIGN="LEFT">estado BOOLEAN DEFAULT TRUE</TD></TR>
      </TABLE>
    >];

    producto [label=<
      <TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" CELLPADDING="6">
        <TR><TD COLSPAN="2" BGCOLOR="#E5D9F7"><B>PRODUCTO</B></TD></TR>
        <TR><TD><B>PK</B></TD><TD ALIGN="LEFT"><B>id_producto</B> INT</TD></TR>
        <TR><TD></TD><TD ALIGN="LEFT">referencia VARCHAR(30) UNIQUE</TD></TR>
        <TR><TD></TD><TD ALIGN="LEFT">nombre VARCHAR(150)</TD></TR>
        <TR><TD></TD><TD ALIGN="LEFT">descripcion TEXT</TD></TR>
        <TR><TD></TD><TD ALIGN="LEFT">precio DECIMAL(10,2)</TD></TR>
        <TR><TD></TD><TD ALIGN="LEFT">estado BOOLEAN DEFAULT TRUE</TD></TR>
        <TR><TD></TD><TD ALIGN="LEFT">es_nuevo BOOLEAN DEFAULT FALSE</TD></TR>
        <TR><TD></TD><TD ALIGN="LEFT">es_oferta BOOLEAN DEFAULT FALSE</TD></TR>
        <TR><TD></TD><TD ALIGN="LEFT">es_destacado BOOLEAN DEFAULT FALSE</TD></TR>
        <TR><TD><B>FK</B></TD><TD ALIGN="LEFT">id_categoria INT</TD></TR>
      </TABLE>
    >];

    producto_imagen [label=<
      <TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" CELLPADDING="6">
        <TR><TD COLSPAN="2" BGCOLOR="#D9F0E1"><B>PRODUCTO_IMAGEN</B></TD></TR>
        <TR><TD><B>PK</B></TD><TD ALIGN="LEFT"><B>id_imagen</B> INT</TD></TR>
        <TR><TD><B>FK</B></TD><TD ALIGN="LEFT">id_producto INT</TD></TR>
        <TR><TD></TD><TD ALIGN="LEFT">url_imagen VARCHAR(500)</TD></TR>
        <TR><TD></TD><TD ALIGN="LEFT">texto_alternativo VARCHAR(255)</TD></TR>
        <TR><TD></TD><TD ALIGN="LEFT">orden INT DEFAULT 1</TD></TR>
        <TR><TD></TD><TD ALIGN="LEFT">principal BOOLEAN DEFAULT FALSE</TD></TR>
      </TABLE>
    >];

    talla [label=<
      <TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" CELLPADDING="6">
        <TR><TD COLSPAN="2" BGCOLOR="#FFF0C7"><B>TALLA</B></TD></TR>
        <TR><TD><B>PK</B></TD><TD ALIGN="LEFT"><B>id_talla</B> INT</TD></TR>
        <TR><TD></TD><TD ALIGN="LEFT">nombre VARCHAR(20) UNIQUE</TD></TR>
        <TR><TD></TD><TD ALIGN="LEFT">estado BOOLEAN DEFAULT TRUE</TD></TR>
      </TABLE>
    >];

    color [label=<
      <TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" CELLPADDING="6">
        <TR><TD COLSPAN="2" BGCOLOR="#FFF0C7"><B>COLOR</B></TD></TR>
        <TR><TD><B>PK</B></TD><TD ALIGN="LEFT"><B>id_color</B> INT</TD></TR>
        <TR><TD></TD><TD ALIGN="LEFT">nombre VARCHAR(50) UNIQUE</TD></TR>
        <TR><TD></TD><TD ALIGN="LEFT">codigo_hex VARCHAR(7)</TD></TR>
        <TR><TD></TD><TD ALIGN="LEFT">estado BOOLEAN DEFAULT TRUE</TD></TR>
      </TABLE>
    >];

    variante_producto [label=<
      <TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" CELLPADDING="6">
        <TR><TD COLSPAN="2" BGCOLOR="#E7D9F8"><B>VARIANTE_PRODUCTO</B></TD></TR>
        <TR><TD><B>PK</B></TD><TD ALIGN="LEFT"><B>id_variante</B> INT</TD></TR>
        <TR><TD><B>FK</B></TD><TD ALIGN="LEFT">id_producto INT</TD></TR>
        <TR><TD><B>FK</B></TD><TD ALIGN="LEFT">id_talla INT</TD></TR>
        <TR><TD><B>FK</B></TD><TD ALIGN="LEFT">id_color INT</TD></TR>
        <TR><TD></TD><TD ALIGN="LEFT">sku VARCHAR(50) UNIQUE</TD></TR>
        <TR><TD></TD><TD ALIGN="LEFT">estado BOOLEAN DEFAULT TRUE</TD></TR>
      </TABLE>
    >];

    inventario [label=<
      <TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" CELLPADDING="6">
        <TR><TD COLSPAN="2" BGCOLOR="#D9EEF7"><B>INVENTARIO</B></TD></TR>
        <TR><TD><B>PK</B></TD><TD ALIGN="LEFT"><B>id_inventario</B> INT</TD></TR>
        <TR><TD><B>FK</B></TD><TD ALIGN="LEFT">id_variante INT UNIQUE</TD></TR>
        <TR><TD></TD><TD ALIGN="LEFT">stock_actual INT DEFAULT 0</TD></TR>
        <TR><TD></TD><TD ALIGN="LEFT">stock_minimo INT DEFAULT 3</TD></TR>
        <TR><TD></TD><TD ALIGN="LEFT">fecha_actualizacion DATETIME</TD></TR>
      </TABLE>
    >];

    rol [label=<
      <TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" CELLPADDING="6">
        <TR><TD COLSPAN="2" BGCOLOR="#D9F0E1"><B>ROL</B></TD></TR>
        <TR><TD><B>PK</B></TD><TD ALIGN="LEFT"><B>id_rol</B> INT</TD></TR>
        <TR><TD></TD><TD ALIGN="LEFT">nombre VARCHAR(50) UNIQUE</TD></TR>
        <TR><TD></TD><TD ALIGN="LEFT">descripcion VARCHAR(255)</TD></TR>
      </TABLE>
    >];

    usuario [label=<
      <TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" CELLPADDING="6">
        <TR><TD COLSPAN="2" BGCOLOR="#D9EAF7"><B>USUARIO</B></TD></TR>
        <TR><TD><B>PK</B></TD><TD ALIGN="LEFT"><B>id_usuario</B> INT</TD></TR>
        <TR><TD></TD><TD ALIGN="LEFT">nombre VARCHAR(100)</TD></TR>
        <TR><TD></TD><TD ALIGN="LEFT">apellido VARCHAR(100)</TD></TR>
        <TR><TD></TD><TD ALIGN="LEFT">correo VARCHAR(150) UNIQUE</TD></TR>
        <TR><TD></TD><TD ALIGN="LEFT">password_hash VARCHAR(255)</TD></TR>
        <TR><TD></TD><TD ALIGN="LEFT">estado BOOLEAN DEFAULT TRUE</TD></TR>
        <TR><TD><B>FK</B></TD><TD ALIGN="LEFT">id_rol INT</TD></TR>
      </TABLE>
    >];

    cliente [label=<
      <TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" CELLPADDING="6">
        <TR><TD COLSPAN="2" BGCOLOR="#D9F0E1"><B>CLIENTE</B></TD></TR>
        <TR><TD><B>PK</B></TD><TD ALIGN="LEFT"><B>id_cliente</B> INT</TD></TR>
        <TR><TD></TD><TD ALIGN="LEFT">nombre VARCHAR(100)</TD></TR>
        <TR><TD></TD><TD ALIGN="LEFT">telefono VARCHAR(20)</TD></TR>
        <TR><TD></TD><TD ALIGN="LEFT">correo VARCHAR(150)</TD></TR>
        <TR><TD></TD><TD ALIGN="LEFT">direccion VARCHAR(200)</TD></TR>
        <TR><TD></TD><TD ALIGN="LEFT">barrio VARCHAR(100)</TD></TR>
        <TR><TD></TD><TD ALIGN="LEFT">referencia_direccion VARCHAR(255)</TD></TR>
      </TABLE>
    >];

    pedido [label=<
      <TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" CELLPADDING="6">
        <TR><TD COLSPAN="2" BGCOLOR="#D9EAF7"><B>PEDIDO</B></TD></TR>
        <TR><TD><B>PK</B></TD><TD ALIGN="LEFT"><B>id_pedido</B> INT</TD></TR>
        <TR><TD><B>FK</B></TD><TD ALIGN="LEFT">id_cliente INT</TD></TR>
        <TR><TD><B>FK</B></TD><TD ALIGN="LEFT">id_usuario_vendedor INT NULL</TD></TR>
        <TR><TD></TD><TD ALIGN="LEFT">fecha_pedido DATETIME</TD></TR>
        <TR><TD></TD><TD ALIGN="LEFT">estado VARCHAR(30)</TD></TR>
        <TR><TD></TD><TD ALIGN="LEFT">total DECIMAL(10,2)</TD></TR>
        <TR><TD><B>FK</B></TD><TD ALIGN="LEFT">id_usuario_confirmacion INT NULL</TD></TR>
        <TR><TD></TD><TD ALIGN="LEFT">fecha_confirmacion DATETIME NULL</TD></TR>
      </TABLE>
    >];

    detalle_pedido [label=<
      <TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" CELLPADDING="6">
        <TR><TD COLSPAN="2" BGCOLOR="#F6D9E0"><B>DETALLE_PEDIDO</B></TD></TR>
        <TR><TD><B>PK</B></TD><TD ALIGN="LEFT"><B>id_detalle</B> INT</TD></TR>
        <TR><TD><B>FK</B></TD><TD ALIGN="LEFT">id_pedido INT</TD></TR>
        <TR><TD><B>FK</B></TD><TD ALIGN="LEFT">id_variante INT</TD></TR>
        <TR><TD></TD><TD ALIGN="LEFT">cantidad INT</TD></TR>
        <TR><TD></TD><TD ALIGN="LEFT">precio_unitario DECIMAL(10,2)</TD></TR>
        <TR><TD></TD><TD ALIGN="LEFT">subtotal DECIMAL(10,2)</TD></TR>
      </TABLE>
    >];

    movimiento_inventario [label=<
      <TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" CELLPADDING="6">
        <TR><TD COLSPAN="2" BGCOLOR="#E5D9F7"><B>MOVIMIENTO_INVENTARIO</B></TD></TR>
        <TR><TD><B>PK</B></TD><TD ALIGN="LEFT"><B>id_movimiento</B> INT</TD></TR>
        <TR><TD><B>FK</B></TD><TD ALIGN="LEFT">id_variante INT</TD></TR>
        <TR><TD><B>FK</B></TD><TD ALIGN="LEFT">id_usuario INT</TD></TR>
        <TR><TD></TD><TD ALIGN="LEFT">tipo_movimiento VARCHAR(30)</TD></TR>
        <TR><TD></TD><TD ALIGN="LEFT">cantidad INT</TD></TR>
        <TR><TD></TD><TD ALIGN="LEFT">stock_anterior INT</TD></TR>
        <TR><TD></TD><TD ALIGN="LEFT">stock_posterior INT</TD></TR>
        <TR><TD></TD><TD ALIGN="LEFT">motivo VARCHAR(255)</TD></TR>
        <TR><TD></TD><TD ALIGN="LEFT">fecha DATETIME</TD></TR>
      </TABLE>
    >];

    devolucion [label=<
      <TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" CELLPADDING="6">
        <TR><TD COLSPAN="2" BGCOLOR="#F6D9E0"><B>DEVOLUCION</B></TD></TR>
        <TR><TD><B>PK</B></TD><TD ALIGN="LEFT"><B>id_devolucion</B> INT</TD></TR>
        <TR><TD><B>FK</B></TD><TD ALIGN="LEFT">id_pedido INT</TD></TR>
        <TR><TD><B>FK</B></TD><TD ALIGN="LEFT">id_detalle INT</TD></TR>
        <TR><TD><B>FK</B></TD><TD ALIGN="LEFT">id_usuario INT</TD></TR>
        <TR><TD></TD><TD ALIGN="LEFT">cantidad INT</TD></TR>
        <TR><TD></TD><TD ALIGN="LEFT">motivo VARCHAR(100)</TD></TR>
        <TR><TD></TD><TD ALIGN="LEFT">estado_producto VARCHAR(50)</TD></TR>
        <TR><TD></TD><TD ALIGN="LEFT">vuelve_inventario BOOLEAN</TD></TR>
        <TR><TD></TD><TD ALIGN="LEFT">observaciones TEXT</TD></TR>
        <TR><TD></TD><TD ALIGN="LEFT">fecha DATETIME</TD></TR>
      </TABLE>
    >];

    historial_precio [label=<
      <TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" CELLPADDING="6">
        <TR><TD COLSPAN="2" BGCOLOR="#F6D9E0"><B>HISTORIAL_PRECIO</B></TD></TR>
        <TR><TD><B>PK</B></TD><TD ALIGN="LEFT"><B>id_historial_precio</B> INT</TD></TR>
        <TR><TD><B>FK</B></TD><TD ALIGN="LEFT">id_producto INT</TD></TR>
        <TR><TD><B>FK</B></TD><TD ALIGN="LEFT">id_usuario INT</TD></TR>
        <TR><TD></TD><TD ALIGN="LEFT">precio_anterior DECIMAL(10,2)</TD></TR>
        <TR><TD></TD><TD ALIGN="LEFT">precio_nuevo DECIMAL(10,2)</TD></TR>
        <TR><TD></TD><TD ALIGN="LEFT">motivo VARCHAR(255)</TD></TR>
        <TR><TD></TD><TD ALIGN="LEFT">fecha DATETIME</TD></TR>
      </TABLE>
    >];

    // 19 relaciones exactas del SQL
    categoria -> producto [label="1 : N"];
    producto -> producto_imagen [label="1 : N"];
    producto -> variante_producto [label="1 : N"];
    talla -> variante_producto [label="1 : N"];
    color -> variante_producto [label="1 : N"];
    variante_producto -> inventario [label="1 : 1"];
    rol -> usuario [label="1 : N"];
    cliente -> pedido [label="1 : N"];
    usuario -> pedido [label="1 : N\nvendedor"];
    usuario -> pedido [label="1 : N\nconfirmador"];
    pedido -> detalle_pedido [label="1 : N"];
    variante_producto -> detalle_pedido [label="1 : N"];
    variante_producto -> movimiento_inventario [label="1 : N"];
    usuario -> movimiento_inventario [label="1 : N"];
    pedido -> devolucion [label="1 : N"];
    detalle_pedido -> devolucion [label="1 : N"];
    usuario -> devolucion [label="1 : N"];
    producto -> historial_precio [label="1 : N"];
    usuario -> historial_precio [label="1 : N"];
}
